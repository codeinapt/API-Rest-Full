{
  "realm": "inventory",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Registers products and stock movements" },
      { "name": "supervisor", "description": "Operator rights plus adjustments and reactivations in their areas" },
      { "name": "admin", "description": "Manages areas, categories and product categories; never touches stock" }
    ]
  },
  "groups": [
    {
      "name": "areas",
      "subGroups": [
        { "name": "FOOD" },
        { "name": "CLEAN" },
        { "name": "TOOLS" }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles in realm_access.roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "inventory.read",
      "description": "Read inventory data",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "inventory.write",
      "description": "Change inventory data",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "inventory-swagger",
      "name": "Inventory Swagger UI",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:8080/swagger/oauth2-redirect.html"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": ["inventory.read", "inventory.write"],
      "protocolMappers": [
        {
          "name": "inventory-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "areas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "areas",
            "full.path": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator1",
      "enabled": true,
      "email": "operator1@inventory.local",
      "emailVerified": true,
      "firstName": "Operator",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "Inventory123!", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "supervisor.food",
      "enabled": true,
      "email": "supervisor.food@inventory.local",
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "Food",
      "credentials": [{ "type": "password", "value": "Inventory123!", "temporary": false }],
      "realmRoles": ["supervisor"],
      "groups": ["/areas/FOOD"]
    },
    {
      "username": "supervisor.tools",
      "enabled": true,
      "email": "supervisor.tools@inventory.local",
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "Tools",
      "credentials": [{ "type": "password", "value": "Inventory123!", "temporary": false }],
      "realmRoles": ["supervisor"],
      "groups": ["/areas/TOOLS"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@inventory.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "Inventory123!", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
