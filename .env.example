# Copy to .env and replace the placeholder secrets. .env is gitignored.
# SQL Server SA password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Adm1n!
AUTH_AUDIENCE=inventory-api
SWAGGER_OAUTH_CLIENT_ID=inventory-swagger
# Only for running the API outside Docker (dotnet run); docker compose builds its own values.
INVENTORY_DB_CONNECTION=Server=localhost,1433;Database=Inventory;User Id=sa;Password=ChangeMe_Str0ng!;TrustServerCertificate=True
AUTH_AUTHORITY=http://localhost:8180/realms/inventory
AUTH_METADATA_ADDRESS=http://localhost:8180/realms/inventory/.well-known/openid-configuration
